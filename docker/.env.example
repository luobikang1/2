# ============================================================================
#  🦊 白狐 (White Fox) — 环境变量配置
#  只需填写 TUNNEL_TOKEN 和 UUID 即可运行
# ============================================================================

# [必填] Cloudflare 隧道令牌
# 在 Zero Trust 面板 > Networks > Tunnels 创建隧道后获取
# 留空则自动启用 TryCloudflare 临时隧道（域名每次重启会变）
TUNNEL_TOKEN=

# [必填] 节点 UUID（VLESS/VMess/Trojan/TUIC 共用）
# 留空会自动生成（每次重启变化，建议固定）
UUID=

# [推荐] 隧道绑定的域名（用于打印链接、TUIC 证书 SNI）
ARGO_DOMAIN=

# [可选] 节点名称前缀
NODE_NAME=白狐

# [可选] WS 路径（修改需同步调整 Cloudflare 隧道的 Public Hostname 配置）
VLESS_PATH=/vless
VMESS_PATH=/vmess
TROJAN_PATH=/trojan

# [可选] 内部监听端口
VLESS_PORT=8001
VMESS_PORT=8002
TROJAN_PORT=8003
TUIC_PORT=443

# [可选] TUIC 密码（默认与 UUID 相同）
TUIC_PASSWORD=

# [可选] 日志级别 (trace/debug/info/warn/error)
LOG_LEVEL=info
