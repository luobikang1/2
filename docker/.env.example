# ============================================================================
#  🦊 北极狐 (Arctic Fox) 环境变量示例
#  复制为 .env 后填写，最少只需 TUNNEL_TOKEN 与 UUID
# ============================================================================

# 【必填】Cloudflare 隧道令牌 (Zero Trust -> Networks -> Tunnels -> 你的隧道 -> 安装命令里的 token)
# 留空则启用临时 TryCloudflare 隧道（域名随机、重启变化，仅供测试）
TUNNEL_TOKEN=

# 【必填】节点 UUID（VLESS/VMess/Trojan/TUIC 共用）。留空容器会自动生成并打印
UUID=

# 【强烈建议】你的固定隧道域名，例如 node.example.com（用于打印节点链接 & 证书 SNI）
ARGO_DOMAIN=

# 节点名称前缀
NODE_NAME=北极狐

# --- 以下一般无需修改 ---
# WS 路径
VLESS_PATH=/vless
VMESS_PATH=/vmess
TROJAN_PATH=/trojan

# sing-box 各协议本地监听端口（cloudflared ingress 指向这些端口）
VLESS_PORT=8001
VMESS_PORT=8002
TROJAN_PORT=8003

# TUIC 直连 UDP 端口与密码（密码留空则等于 UUID）
TUIC_PORT=443
TUIC_PASSWORD=

# 日志级别 info/warn/error/debug
LOG_LEVEL=info
